# Local PostgreSQL example. Replace credentials with your own.
DATABASE_URL=postgresql://postgres:your_password@localhost:5432/cep_exchange
PORT=3001
FRONTEND_ORIGIN=http://localhost:3000
JWT_ACCESS_SECRET=replace_with_a_long_random_secret_at_least_32_chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=replace_with_another_long_random_secret_at_least_32_chars
JWT_REFRESH_EXPIRES_IN=7d
# Optional TLS for hosted PostgreSQL; set true only when required by your provider.
DATABASE_SSL=false

# Cloudinary image storage (get these values from Cloudinary Dashboard)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Cloudinary image storage (get these values from Cloudinary Dashboard)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
